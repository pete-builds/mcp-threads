# --- Meta / Threads app (App Dashboard > App settings > Basic) ---
THREADS_APP_ID=
# "Threads App secret" — NEVER commit, never send to a client, server-side only.
THREADS_APP_SECRET=

# --- Bearer token for the HTTP transport: REQUIRED ---
# The server refuses to start on HTTP without this. There is no setting that
# runs HTTP open. Generate a value with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# It belongs in .env on the host only (chmod 600 .env): never in
# docker-compose.yml, never in git. Every client then sends
#   Authorization: Bearer <token>
# stdio (MCP_TRANSPORT=stdio, local development) needs no token.
MCP_AUTH_TOKEN=

# --- One-time credential seed ---
# Long-lived token printed by bootstrap.py. The server consumes this ONCE, on
# first boot, when the data volume is empty. From then on the volume is
# authoritative: refreshes REPLACE the token there and this value goes stale.
# That is expected. Do not "fix" it by pasting a new value unless you have
# deliberately wiped the volume.
THREADS_SEED_TOKEN=

# --- Optional overrides ---
# Meta's docs are inconsistent: token endpoints are documented on
# graph.threads.com, publishing/read endpoints on graph.threads.net/v1.0, and
# Meta has been migrating .net to .com. Both are configurable for that reason.
# THREADS_GRAPH_BASE=https://graph.threads.net/v1.0
# THREADS_AUTH_BASE=https://graph.threads.com

# Token store location (a named Docker volume in production).
# THREADS_DATA_DIR=/data

# Transport / logging
# MCP_HOST=0.0.0.0
# MCP_PORT=3726
# MCP_TRANSPORT=streamable-http
# MCP_LOG_LEVEL=INFO
# MCP_LOG_FORMAT=json

# --- bootstrap.py only (not read by the server) ---
# THREADS_OAUTH_BASE=https://graph.threads.net   # short-lived code exchange (POST)
# THREADS_REDIRECT_URI=                          # if the dashboard rewrote the URI
# THREADS_SCOPES=                                # fallback if authorize rejects threads_delete
